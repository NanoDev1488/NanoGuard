{
  "name": "nanoguard",
  "version": "1.0.0",
  "description": "Native Bytecode Armor & Backdoor Hunter for Minecraft & Java Plugins",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build --emptyOutDir",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win portable"
  },
  "author": "NanoDev <t.me/WineSquad>",
  "license": "MIT",
  "build": {
    "appId": "com.nanodev.nanoguard",
    "productName": "NanoGuard",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "resources/engine_cpp/bin/**/*",
      "crates/target/release/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19"
  },
  "dependencies": {
    "lucide-react": "^0.323.0"
  }
}
